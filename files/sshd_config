# Secure defaults
# See: https://stribika.github.io/2015/01/04/secure-secure-shell.html
Protocol 2
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# Faster connection
# See: https://github.com/atmoz/sftp/issues/11
UseDNS no

# Limited access
PermitRootLogin no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
DisableForwarding yes
PermitUserRC no
PermitTTY no
PermitUserEnvironment no

# rsync only: every session runs rrsync rooted at the user's home folder,
# whatever command the client asks for or authorized_keys says.
ForceCommand /usr/local/bin/rsync-only

# Allow both password and public key authentication
# Change as needed
PasswordAuthentication no    # yes to allow plain text password authentication
PubkeyAuthentication yes

# Enable this for more logs
# LogLevel VERBOSE
